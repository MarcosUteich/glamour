# Copie para .env.local e preencha. Na hospedagem (Docker/Coolify/EasyPanel ou Vercel), cadastre as mesmas
# variáveis: as VITE_* entram no build, então depois de mudar alguma é preciso publicar de novo.

# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://fcyuqnpujhlkupthncli.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZjeXVxbnB1amhsa3VwdGhuY2xpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwODQ1NzIsImV4cCI6MjEwNDY2MDU3Mn0.-iuPBHv1-PoGXLiXqOe0tr5hmbp0ZRTrH1uBvYlDSMA

# Endereço do site. Pode ser só o domínio; o código completa o https:// e tira a barra do fim.
VITE_SITE_URL=https://glamourlindoia.com.br

# Medição (opcional; só carregam no build de produção e depois do "Aceitar" no aviso de cookies). Veja docs/SEO.md.
# Google Analytics 4 → Administrador → Fluxos de dados → ID da métrica
VITE_GA_ID=

# Meta → Gerenciador de Eventos → ID do Pixel (só números)
VITE_META_PIXEL_ID=

# Google Ads (opcional): ID da conta (AW-...) e rótulo da conversão "pedido"
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=

# Microsoft Clarity (opcional): mapas de clique e gravações de sessão
VITE_CLARITY_ID=

# Verificação de domínio (opcional se você verificar pelo DNS). Pode colar só o código ou a tag inteira.
# Google Search Console → método "Tag HTML"
VITE_GOOGLE_SITE_VERIFICATION=

# Meta → Configurações da empresa → Segurança da marca → Domínios → "Metatag"
VITE_META_DOMAIN_VERIFICATION=

# Turnstile: chave pública do widget usado no login /admin.
# Cadastre localhost (sem porta) e o domínio de produção nos hostnames do widget.
# Chave secreta: configure apenas no Supabase → Authentication → Bot and Abuse Protection.
# Se ativar CAPTCHA no Supabase, esta chave pública precisa estar preenchida.
VITE_TURNSTILE_SITE_KEY=
